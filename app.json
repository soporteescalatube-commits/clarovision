{
  "expo": {
    "name": "clarovision",
    "slug": "clarovision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarovision",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alberto.clarovision",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Esta app usa reconocimiento de voz para entender tus comandos.",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para escucharte.",
        "NSCameraUsageDescription": "Esta app necesita la cámara para describir lo que tienes delante.",
        "NSLocationWhenInUseUsageDescription": "Esta app usa tu ubicación para ayudarte a orientarte.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta app puede usar tu ubicación para darte información más precisa."
      }
    },

    "android": {
      "package": "com.alberto.clarovision",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-speech-recognition",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}